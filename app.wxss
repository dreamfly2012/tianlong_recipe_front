/**app.wxss**/
@import "/styles/regular.min.wxss";
@import "/styles/theme.wxss";

/* 设计令牌：高对比度暖色美食主题（色弱友好） */
page {
  /* 颜色 */
  --primary: #FF6B00;
  --primary-dark: #E25800;
  --primary-light: #FFF1E6;
  --accent: #D84315;          /* 危险/强调，深橙红，保证对比 */
  --success: #2E7D32;
  --bg: #F5F6F8;
  --card: #FFFFFF;
  --text: #1A1A1A;            /* 主文本，极高对比 */
  --text-2: #54565B;          /* 次级文本，仍保持可读对比 */
  --border: #E6E6E6;

  /* 形状与阴影 */
  --radius: 24rpx;
  --radius-sm: 14rpx;
  --shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.5;
}

view, text, input, textarea, button, image, scroll-view, navigator {
  box-sizing: border-box;
}

.container {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 通用页面容器：顶部留白，左右 24rpx */
.page-padding {
  padding: 24rpx;
}

/* 全局加载中 */
.loading-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 246, 248, 0.6);
  z-index: 999;
}
.loading-mask .spinner {
  width: 64rpx; height: 64rpx;
  border: 6rpx solid #FFD9BC;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
