/* profile/index.wxss */
.profile-container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  padding: 60rpx 32rpx 56rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.header-inner {
  display: flex;
  align-items: center;
}
.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255,255,255,0.3);
  border: 4rpx solid rgba(255,255,255,0.6);
}
/* 头像选择按钮（登录后更换头像）*/
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}
.avatar-btn::after { border: none; }
.header-text {
  margin-left: 24rpx;
  flex: 1;
}
.title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
}
.subtitle {
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  margin-top: 8rpx;
}
/* 昵称输入框（登录后编辑昵称复用，微信 type="nickname" 能力） */
.nickname-input {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  box-sizing: border-box;
}
.nickname-input::placeholder {
  color: rgba(255,255,255,0.7);
}

/* 已登录：昵称展示与编辑 */
.nickname-row {
  display: flex;
  align-items: center;
}
.nickname-text {
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.edit-link {
  margin-left: 16rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.22);
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 28rpx;
}
.edit-link:active { opacity: 0.75; }

/* 昵称编辑操作按钮（保存/取消） */
.nickname-actions {
  margin-top: 36rpx;
  display: flex;
}
.action-btn {
  padding: 12rpx 40rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255,255,255,0.22);
  border-radius: 40rpx;
}
.action-btn--primary {
  background: #fff;
  color: var(--primary-dark);
  font-weight: 700;
}
.action-btn:active { opacity: 0.8; }

.login-btn {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: var(--primary-dark);
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.12);
}
.login-btn[disabled] {
  background: rgba(255,255,255,0.55);
  color: rgba(0,0,0,0.3);
}
.login-btn::after { border: none; }
.btn-hover { opacity: 0.85; transform: scale(0.98); }

.logout-btn {
  margin-top: 36rpx;
  align-self: flex-start;
  background: rgba(255,255,255,0.22);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
}

/* 区块 */
.section {
  padding: 28rpx 24rpx 4rpx;
}
.recipe-card .cover {
  width: 100%;
  height: 200rpx;
  background: #EEE;
}

/* 设置入口 */
.menu-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow);
}
.menu-card:active { transform: scale(0.99); }
.menu-left {
  display: flex;
  align-items: center;
}
.menu-ico { font-size: 40rpx; margin-right: 20rpx; }
.menu-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.menu-arrow {
  color: #BDBDBD;
  font-size: 40rpx;
}
