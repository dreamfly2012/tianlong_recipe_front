<!--category/index.wxml-->
<view class="cat-page">

  <!-- 顶部搜索 -->
  <view class="search-wrap">
    <view class="search-bar">
      <image class="ico" src="/image/search.png"></image>
      <input class="input" placeholder="搜索你想要的菜谱"
             value="{{inputValue}}" bindinput="onSearchChange"
             bindconfirm="onSearchConfirm" confirm-type="search" />
      <view class="voice-btn {{isRecording ? 'recording' : ''}}"
            bindtouchstart="startVoiceInput" bindtouchend="stopVoiceInput">
        <image class="voice-ico" src="/image/yuyin.png"></image>
      </view>
    </view>
  </view>

  <!-- 双栏分类 -->
  <view class="classify">
    <scroll-view scroll-y="true" class="left-navbar">
      <block wx:if="{{categories.length}}">
        <view class="nav-item {{curNav == item.id ? 'active' : ''}}"
              wx:for="{{categories}}" wx:key="id"
              bindtap="switchNav" data-id="{{item.id}}">
          {{item.name}}
        </view>
      </block>
      <block wx:elif="{{loadingTop}}">
        <view class="nav-skeleton" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this"></view>
      </block>
    </scroll-view>

    <scroll-view scroll-y="true" class="right">
      <view class="right-title">{{curName || '子分类'}} · 子分类</view>
      <block wx:if="{{children.length}}">
        <view class="sub-grid">
          <view class="sub-card" wx:for="{{children}}" wx:key="id"
                bindtap="jumplist" data-id="{{item.id}}">
            <view class="sub-name">{{item.name}}</view>
          </view>
        </view>
      </block>
      <block wx:elif="{{loadingChildren}}">
        <view class="sub-grid">
          <view class="sub-card skeleton" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
        </view>
      </block>
      <view class="empty" wx:else>
        <view class="text">暂无子分类</view>
      </view>
    </scroll-view>
  </view>

</view>
