/* category/index.wxss */
.cat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 顶部搜索 */
.search-wrap {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border-radius: 44rpx;
  height: 76rpx;
  padding: 0 24rpx;
}
.search-bar .ico {
  width: 36rpx; height: 36rpx; margin-right: 14rpx; opacity: 0.5;
}
.search-bar .input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}
.voice-btn {
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
  margin-left: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.voice-btn.recording {
  background: var(--primary);
}
.voice-ico {
  width: 36rpx; height: 36rpx;
}

/* 双栏 */
.classify {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.left-navbar {
  width: 200rpx;
  height: 100%;
  background: #fff;
  border-right: 1rpx solid var(--border);
}
.nav-item {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  position: relative;
}
.nav-item.active {
  color: var(--primary-dark);
  font-weight: 700;
  background: var(--bg);
}
.nav-item.active::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 8rpx; height: 40rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FF8A3D 0%, #FF6B00 100%);
}

.right {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  padding: 24rpx;
}
.right-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.sub-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.sub-card {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: var(--shadow);
}
.sub-card:active { transform: scale(0.97); }
.sub-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

/* 加载骨架（消除“卡住”感） */
.nav-skeleton {
  height: 96rpx;
  margin: 0 28rpx;
  border-radius: 12rpx;
  background: #ECECEC;
  animation: cat-sk 1.2s ease-in-out infinite;
}
.sub-card.skeleton {
  background: #ECECEC;
  animation: cat-sk 1.2s ease-in-out infinite;
}
@keyframes cat-sk {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
