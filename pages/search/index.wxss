/* search/index.wxss */
.search-page {
  min-height: 100vh;
  background: var(--bg);
}

.search-wrap {
  padding: 20rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border-radius: 44rpx;
  height: 76rpx;
  padding: 0 12rpx 0 24rpx;
}
.search-bar .ico {
  width: 36rpx; height: 36rpx; margin-right: 14rpx; opacity: 0.5;
}
.search-bar .input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}
.search-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 40rpx;
}

.result {
  padding: 24rpx;
}
.result-head {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.result-head .hl {
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 30rpx;
}

.recipe-card .cover {
  width: 100%;
  height: 220rpx;
  background: #EEE;
}

.list-end {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 30rpx 0 10rpx;
}
