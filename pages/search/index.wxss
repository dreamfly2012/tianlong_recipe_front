/* search/index.wxss */
.search-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ---------- 搜索栏 ---------- */
.search-wrap {
  padding: 20rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border-radius: 44rpx;
  height: 76rpx;
  padding: 0 12rpx 0 24rpx;
}
.search-bar .ico {
  width: 36rpx; height: 36rpx; margin-right: 14rpx; opacity: 0.5;
}
.search-bar .input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
}
.search-bar .clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: #C4C6CC;
  color: #fff;
  font-size: 30rpx;
  margin-right: 10rpx;
}
.search-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 40rpx;
}

/* ---------- 历史 / 热门面板 ---------- */
.panel {
  background: #fff;
  padding: 8rpx 24rpx 16rpx;
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 12rpx;
}
.panel-head.gap {
  margin-top: 20rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border);
}
.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.panel-action {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 8rpx 0 8rpx 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 14rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: #F2F3F5;
  color: var(--text);
  font-size: 26rpx;
  line-height: 1;
}
.chip:active {
  background: #E6E7EA;
}
.chip.hot {
  background: var(--primary-light);
  color: var(--primary-dark);
}
.chip .rank {
  font-weight: 700;
  margin-right: 8rpx;
}

/* ---------- 输入联想 ---------- */
.suggest {
  background: #fff;
}
.suggest-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.suggest-item:active {
  background: #FAFAFA;
}
.suggest-item:last-child {
  border-bottom: none;
}
.suggest-item .ico {
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  opacity: 0.35;
  flex-shrink: 0;
}
.suggest-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.suggest-text .hit {
  color: var(--primary-dark);
  font-weight: 700;
}
.suggest-empty {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}

/* ---------- 结果 ---------- */
.result {
  padding: 24rpx;
}
.result-head {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.result-head .hl {
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 30rpx;
}

.loading-tip {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}

.recipe-card .cover {
  width: 100%;
  height: 220rpx;
  background: #EEE;
}

.list-end {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 30rpx 0 10rpx;
}

/* ---------- 空结果再试入口 ---------- */
.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.empty .chips {
  justify-content: center;
  margin-top: 32rpx;
  padding: 0 12rpx;
}
.empty .chip {
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
