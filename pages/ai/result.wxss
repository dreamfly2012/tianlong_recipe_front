.result-detail-container {
  padding: 32rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 24rpx #e0e0e0;
  padding: 32rpx 24rpx;
  margin-bottom: 32rpx;
}

.recipe-image {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx #e0e0e0;
  margin-bottom: 24rpx;
  object-fit: cover;
}

.recipe-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 12rpx;
  text-align: center;
}

.recipe-desc {
  color: #666;
  margin-bottom: 18rpx;
  text-align: center;
  font-size: 28rpx;
}

.recipe-tags {
  margin-bottom: 18rpx;
  text-align: center;
}
.tag {
  display: inline-block;
  background: linear-gradient(90deg, #a8edea 0%, #fed6e3 100%);
  color: #00796b;
  font-size: 24rpx;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  margin: 0 8rpx 8rpx 0;
  font-weight: 500;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4caf50;
  margin: 28rpx 0 12rpx 0;
  border-left: 8rpx solid #4caf50;
  padding-left: 16rpx;
}

.ingredients-list, .steps-list {
  margin-bottom: 18rpx;
}

.ingredient, .step {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #444;
  background: #f2f6f9;
  border-radius: 8rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 8rpx;
  position: relative;
}

.ingredient::before, .step::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: #4caf50;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 12rpx;
}

.step {
  counter-increment: step;
}
.step::before {
  content: counter(step) '.';
  color: #4caf50;
  font-weight: bold;
  margin-right: 16rpx;
  background: none;
  width: auto;
  height: auto;
}

.recipe-info {
  margin-top: 24rpx;
  color: #888;
  font-size: 26rpx;
  text-align: center;
}

.error-msg {
  color: #f44;
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
} 