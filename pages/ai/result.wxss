/* ai/result.wxss */
page {
  /* 进场时先用暖色打底，避免结果页 push 进场首帧白屏闪烁 */
  background: #FFF7EF;
}

.result-detail-container {
  padding: 24rpx;
  background: var(--bg);
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.recipe-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #EEE;
  margin-bottom: 24rpx;
}

.recipe-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}

.recipe-desc {
  color: var(--text-2);
  margin-top: 12rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.5;
}

.recipe-tags {
  margin-top: 20rpx;
  text-align: center;
}

.info-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.info-item {
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--primary-light);
  color: var(--primary-dark);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.ingredient-row:last-child { border-bottom: none; }
.ingredient-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}
.ingredient-qty {
  font-size: 28rpx;
  color: var(--text-2);
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}
.step-no {
  flex-shrink: 0;
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6A5CFF 0%, #8E54E9 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  margin-right: 20rpx;
}
.step-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.6;
  padding-top: 4rpx;
}

/* ===== 可爱厨师加载动画（高对比度，色弱友好） ===== */
.chef-loading {
  flex-direction: column;
  background: linear-gradient(160deg, #FFF7EF 0%, #FFE9D6 100%);
}
.chef-stage {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

/* 飘动的食材 */
.float-food {
  position: absolute;
  font-size: 56rpx;
  opacity: 0;
  animation: floatUp 3s ease-in-out infinite;
}
.ff1 { left: 12%;  top: 30%; animation-delay: 0s; }
.ff2 { left: 78%;  top: 22%; animation-delay: 0.5s; }
.ff3 { left: 20%;  top: 64%; animation-delay: 1s; }
.ff4 { left: 70%;  top: 60%; animation-delay: 1.5s; }
.ff5 { left: 8%;   top: 48%; animation-delay: 2s; }
.ff6 { left: 86%;  top: 46%; animation-delay: 2.5s; }
.ff7 { left: 44%;  top: 12%; animation-delay: 1.2s; }
@keyframes floatUp {
  0%   { opacity: 0; transform: translateY(20rpx) scale(0.8); }
  25%  { opacity: 1; transform: translateY(0) scale(1); }
  75%  { opacity: 1; transform: translateY(-10rpx) scale(1); }
  100% { opacity: 0; transform: translateY(-40rpx) scale(0.9); }
}

/* 厨师 */
.chef {
  position: relative;
  margin-top: 40rpx;
  animation: chefBob 1.6s ease-in-out infinite;
}
.chef-emoji {
  font-size: 160rpx;
  line-height: 1;
  display: block;
  filter: drop-shadow(0 12rpx 20rpx rgba(255, 107, 0, 0.18));
}
@keyframes chefBob {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50%      { transform: translateY(-18rpx) rotate(3deg); }
}
.chef-shadow {
  width: 120rpx;
  height: 18rpx;
  margin: 16rpx auto 0;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 50%;
  animation: shadowPulse 1.6s ease-in-out infinite;
}
@keyframes shadowPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50%      { transform: scale(0.8); opacity: 0.3; }
}

/* 思考气泡 */
.chef-bubble {
  position: absolute;
  top: -16rpx;
  right: -10rpx;
  font-size: 44rpx;
  animation: bubblePop 1.6s ease-in-out infinite;
}
@keyframes bubblePop {
  0%, 100% { transform: scale(0.85) rotate(-6deg); opacity: 0.85; }
  50%      { transform: scale(1.1) rotate(6deg); opacity: 1; }
}

/* 文案 */
.chef-text {
  margin-top: 36rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
.chef-dots .cd {
  animation: dotBlink 1.2s infinite;
  color: var(--primary);
  font-weight: 900;
}
.chef-dots .cd:nth-child(2) { animation-delay: 0.2s; }
.chef-dots .cd:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBlink {
  0%, 60%, 100% { opacity: 0.2; }
  30%           { opacity: 1; }
}
.chef-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  text-align: center;
  font-weight: 500;
}
