<!--ai/menu.wxml-->
<view class="menu-page">

  <!-- 未登录引导 -->
  <view class="login-banner" wx:if="{{needLogin}}">
    <view class="login-banner-title">🔒 智能菜单生成需登录</view>
    <view class="login-banner-sub">登录后，AI 才能记住你的口味并保存专属菜单</view>
    <button class="login-banner-btn" bindtap="goLogin">微信登录</button>
  </view>

  <view class="tips-card">
    <view class="tips-title">✨ 告诉我你的需求</view>
    <view class="tips-text">AI 将根据食材与偏好，为你生成专属菜谱</view>
  </view>

  <view class="form-card">
    <view class="form-group">
      <view class="label">食材<text class="require">*</text></view>
      <view class="hint">多个食材用逗号分隔，如：三文鱼,芦笋,鸡蛋</view>
      <textarea class="textarea" placeholder="必填：家里现有的食材"
                value="{{ingredientsInput}}" bindinput="onIngredientsInput" maxlength="200" />
    </view>

    <view class="form-group">
      <view class="label">口味偏好<text class="optional">（可选）</text></view>
      <view class="hint">如：低脂,下饭,川味</view>
      <input class="input" placeholder="口味 / 风格偏好"
             value="{{preferencesInput}}" bindinput="onPreferencesInput" />
    </view>

    <view class="form-group">
      <view class="label">忌口 / 排除<text class="optional">（可选）</text></view>
      <view class="hint">如：辣椒,花生,香菜</view>
      <input class="input" placeholder="不想要的食材"
             value="{{excludesInput}}" bindinput="onExcludesInput" />
    </view>

    <view wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</view>

    <button class="generate-btn" hover-class="none" bindtap="generateMenu">生成专属菜谱</button>
  </view>

</view>
