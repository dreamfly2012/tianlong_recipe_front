/* ai/index.wxss */
.ai-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 头部 */
.hero {
  background: linear-gradient(135deg, #6A5CFF 0%, #8E54E9 100%);
  padding: 44rpx 32rpx 56rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.hero-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
}
.hero-sub {
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section {
  padding: 28rpx 24rpx 4rpx;
}

/* 横向滚动 */
.recipe-scroll {
  white-space: nowrap;
}
.recipe-item {
  display: inline-block;
  width: 240rpx;
  margin-right: 18rpx;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  vertical-align: top;
}
.recipe-item:active { transform: scale(0.97); }
.recipe-item-image {
  width: 240rpx;
  height: 160rpx;
  background: #EEE;
  display: block;
}
.recipe-item .recipe-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  padding: 14rpx 16rpx;
}

/* 网格复用全局 .recipe-card */
.recipe-card .cover {
  width: 100%;
  height: 220rpx;
  background: #EEE;
}

/* 骨架屏 */
.skeleton-row, .skeleton-grid {
  display: flex;
}
.skeleton-row { overflow: hidden; }
.skeleton-grid {
  flex-wrap: wrap;
  justify-content: space-between;
}
.recipe-skel {
  width: 240rpx;
  height: 200rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.skeleton-grid .recipe-skel {
  width: calc(50% - 12rpx);
  margin-right: 0;
  margin-bottom: 24rpx;
}

/* 智能菜单卡片 */
.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0C2 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow);
}
.menu-card:active { transform: scale(0.98); }
.menu-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #8A4B00;
}
.menu-card-sub {
  font-size: 24rpx;
  color: #9B6B3A;
  margin-top: 8rpx;
  line-height: 1.4;
}
.menu-card-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
}
