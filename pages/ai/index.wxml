<!--ai/index.wxml-->
<view class="ai-page">

  <!-- 未登录引导 -->
  <view class="login-banner" wx:if="{{needLogin}}">
    <view class="login-banner-title">👋 欢迎使用 AI 美食助手</view>
    <view class="login-banner-sub">登录后即可查看专属推荐、生成智能菜单</view>
    <button class="login-banner-btn" bindtap="goLogin">微信登录</button>
  </view>

  <!-- 头部 -->
  <view class="hero">
    <view class="hero-title">AI 智能美食助手</view>
    <view class="hero-sub">懂你的口味，更懂你的厨房</view>
  </view>

  <!-- 今日推荐 + 为你推荐：仅登录后展示 -->
  <block wx:if="{{!needLogin}}">
  <view class="section">
    <view class="section-title">今日推荐</view>
    <scroll-view scroll-x="true" class="recipe-scroll" wx:if="{{dailyRecipes.length}}">
      <view class="recipe-item" wx:for="{{dailyRecipes}}" wx:key="id"
            bindtap="jumpDetail" data-id="{{item.id}}">
        <image class="recipe-item-image" src="{{item.image_src}}" mode="aspectFill"></image>
        <view class="recipe-name ellipsis">{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="skeleton-row" wx:elif="{{loadingDaily}}">
      <view class="skeleton recipe-skel" wx:for="{{3}}" wx:key="*this"></view>
    </view>
    <view class="empty" wx:else>
      <view class="text">登录后查看专属推荐</view>
    </view>
  </view>

  <!-- 为你推荐：网格 -->
  <view class="section">
    <view class="section-title">为你推荐</view>
    <view class="recipe-grid" wx:if="{{personalizedRecipes.length}}">
      <view class="recipe-card" wx:for="{{personalizedRecipes}}" wx:key="id"
            bindtap="jumpDetail" data-id="{{item.id}}">
        <image class="cover" src="{{item.image_src}}" mode="aspectFill"></image>
        <view class="body">
          <view class="name ellipsis-2">{{item.name}}</view>
        </view>
      </view>
    </view>
    <view class="skeleton-grid" wx:elif="{{loadingPersonal}}">
      <view class="skeleton recipe-skel" wx:for="{{4}}" wx:key="*this"></view>
    </view>
    <view class="empty" wx:else>
      <view class="text">暂无推荐，去生成专属菜单吧</view>
    </view>
  </view>

  </block>

  <!-- 智能菜单 -->
  <view class="section">
    <view class="menu-card" bindtap="goMenu">
      <view class="menu-card-text">
        <view class="menu-card-title">🍱 智能菜单规划</view>
        <view class="menu-card-sub">告诉我你的食材与偏好，生成一周不重样的菜单</view>
      </view>
      <view class="menu-card-btn">去生成</view>
    </view>
  </view>

</view>
