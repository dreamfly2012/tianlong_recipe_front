.menu-container {
  padding: 32rpx;
}
.form-group {
  margin-bottom: 32rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  border: 1px solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fff;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}
.generate-btn {
  background: #4caf50;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  margin: 24rpx 0;
}
.result-section {
  margin-top: 40rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx #eee;
}
.result-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}
.recipe-image {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.recipe-desc {
  color: #666;
  margin-bottom: 12rpx;
}
.recipe-tags {
  margin-bottom: 12rpx;
}
.tag {
  display: inline-block;
  background: #e0f7fa;
  color: #00796b;
  font-size: 24rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 8rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin: 18rpx 0 8rpx 0;
}
.ingredients-list, .steps-list {
  margin-bottom: 12rpx;
}
.ingredient, .step {
  display: block;
  font-size: 26rpx;
  color: #444;
  margin-bottom: 4rpx;
}
.recipe-info {
  margin-top: 16rpx;
  color: #888;
  font-size: 24rpx;
}
.error-msg {
  color: #f44;
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
}
