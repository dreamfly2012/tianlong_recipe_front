/* ai/menu.wxss */
.menu-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.tips-card {
  background: linear-gradient(135deg, #6A5CFF 0%, #8E54E9 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  box-shadow: var(--shadow);
}
.tips-title {
  font-size: 34rpx;
  font-weight: 800;
}
.tips-text {
  font-size: 26rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}

.form-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow);
}
.form-group {
  margin-bottom: 32rpx;
}
.label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}
.require {
  color: var(--accent);
  margin-left: 6rpx;
}
.optional {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-2);
}
.hint {
  font-size: 22rpx;
  color: var(--text-2);
  margin: 8rpx 0 14rpx;
}
.input, .textarea {
  width: 100%;
  background: #F5F6F8;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  font-size: 30rpx;
  color: var(--text);
  box-sizing: border-box;
}
/* 原生 input 不随上下 padding 撑高，必须固定高度并去掉垂直 padding，否则文字被截断 */
.input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}
.textarea {
  height: 180rpx;
  padding: 22rpx 24rpx;
}
.input:focus, .textarea:focus {
  border-color: var(--primary);
}

.error-msg {
  color: var(--accent);
  font-size: 26rpx;
  margin-bottom: 18rpx;
}

.generate-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.28);
}
.generate-btn::after { border: none; }
