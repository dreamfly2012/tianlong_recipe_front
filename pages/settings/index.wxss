/* settings/index.wxss */
.settings-container {
  padding: 24rpx;
  background: var(--bg);
  min-height: 100vh;
}

.header {
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text);
}
.subtitle {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 10rpx;
}

/* 加载 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.loading-spinner {
  width: 64rpx; height: 64rpx;
  border: 6rpx solid #FFD9BC;
  border-top: 6rpx solid var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 表单卡片 */
.form-container {
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  box-shadow: var(--shadow);
}
.form-item {
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid var(--border);
}
.form-item:last-child { border-bottom: none; }
.form-label {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 18rpx;
}
.form-input {
  height: 80rpx;
  font-size: 30rpx;
  color: var(--text);
  padding: 0 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
}

.avatar-item { display: flex; flex-direction: column; }
.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar {
  width: 160rpx; height: 160rpx;
  border-radius: 80rpx;
  background: #EEE;
  border: 4rpx solid var(--border);
}
.avatar-tip {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

.radio-group { display: flex; flex-wrap: wrap; }
.radio-label {
  display: flex;
  align-items: center;
  margin-right: 60rpx;
  margin-bottom: 12rpx;
}
.radio-label text {
  font-size: 28rpx;
  color: var(--text);
  margin-left: 10rpx;
}

.picker-view {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: var(--text);
  padding: 0 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.placeholder { color: var(--text-2); }
.arrow { color: var(--text-2); font-size: 24rpx; }

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  color: var(--text);
  padding: 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 10rpx;
}

.form-actions {
  padding: 40rpx 20rpx;
  display: flex;
  justify-content: center;
}
.save-btn {
  width: 80%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.28);
}
.save-btn::after { border: none; }
.btn-hover { opacity: 0.85; transform: scale(0.98); }
