/**index.wxss**/
.home {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 顶部品牌区 */
.hero {
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  padding: 40rpx 32rpx 56rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.brand-title {
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.brand-sub {
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  margin-top: 8rpx;
}
.search-bar {
  margin-top: 28rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}
.search-bar .ico {
  width: 36rpx; height: 36rpx; margin-right: 16rpx; opacity: 0.55;
}
.search-bar .placeholder {
  color: #9A9A9A;
  font-size: 28rpx;
}

/* 区块 */
.section {
  padding: 28rpx 24rpx 4rpx;
}

/* 分类横向滚动 */
.cate-scroll {
  white-space: nowrap;
}
.cate-chip {
  display: inline-block;
  background: var(--card);
  border-radius: 16rpx;
  padding: 22rpx 32rpx;
  margin-right: 18rpx;
  box-shadow: var(--shadow);
  min-width: 140rpx;
  text-align: center;
}
.cate-chip:active { transform: scale(0.96); }
.cate-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

/* 菜谱网格复用全局 .recipe-card / .recipe-grid */
.recipe-card .cover {
  width: 100%;
  height: 230rpx;
  background: #EEE;
}

/* 列表结尾 */
.list-end {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 30rpx 0 10rpx;
}
