/* info.wxss */
.detail {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* 头图 */
.hero {
  position: relative;
  width: 100%;
  height: 460rpx;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
  background: #EEE;
}
.hero-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%);
}
.back {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 24rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 52rpx;
  line-height: 56rpx;
  text-align: center;
}
.hero-bottom {
  position: absolute;
  left: 24rpx; right: 24rpx; bottom: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.hero-name {
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  flex: 1;
  margin-right: 20rpx;
}
.fav-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  padding: 12rpx 22rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  flex-shrink: 0;
}
.fav-icon {
  color: #C9C9C9;
  font-size: 30rpx;
  margin-right: 8rpx;
}
.fav-text {
  font-size: 26rpx;
  color: #54565B;
}
.fav-btn.active .fav-icon { color: var(--primary); }
.fav-btn.active .fav-text { color: var(--primary-dark); }

/* 概要信息 */
.meta-row {
  display: flex;
  margin: -40rpx 24rpx 0;
  position: relative;
  z-index: 2;
  padding: 28rpx 0;
}
.meta-item {
  flex: 1;
  text-align: center;
  position: relative;
}
.meta-item::after {
  content: "";
  position: absolute;
  right: 0; top: 50%;
  transform: translateY(-50%);
  width: 1rpx; height: 40rpx;
  background: var(--border);
}
.meta-item:last-child::after { display: none; }
.meta-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary-dark);
}
.meta-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 区块卡片 */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx 12rpx;
}

/* 食材 */
.ing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.ing-row:last-child { border-bottom: none; }
.ing-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}
.ing-qty {
  font-size: 28rpx;
  color: var(--text-2);
}

/* 步骤 */
.step-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}
.step-no {
  flex-shrink: 0;
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A3D 0%, #FF6B00 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  margin-right: 20rpx;
}
.step-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.6;
  padding-top: 4rpx;
}

.bottom {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 36rpx 0 0;
}
