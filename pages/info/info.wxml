<!--info.wxml-->
<view class="detail">

  <view wx:if="{{loadError}}" class="error-tip">菜谱不存在或已被删除</view>

  <block wx:else>
    <!-- 头图区（关键修复：名称/收藏按钮作为兄弟节点，不再嵌套在 image 内） -->
    <view class="hero">
      <image class="hero-img" src="{{recipe.image_src}}" mode="aspectFill"></image>
      <view class="hero-mask"></view>

      <view class="back" bindtap="goBack">‹</view>

      <view class="hero-bottom">
        <view class="hero-name">{{recipe.name}}</view>
        <view class="fav-btn {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
          <text class="fav-icon">♥</text>
          <text class="fav-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
    </view>

    <!-- 概要信息 -->
    <view class="meta-row card" wx:if="{{cookingTime || difficulty || recipe.ingredients.length}}">
      <view class="meta-item" wx:if="{{cookingTime}}">
        <view class="meta-num">{{cookingTime}}</view>
        <view class="meta-label">分钟</view>
      </view>
      <view class="meta-item" wx:if="{{difficulty}}">
        <view class="meta-num">{{difficulty}}</view>
        <view class="meta-label">难度</view>
      </view>
      <view class="meta-item" wx:if="{{recipe.ingredients.length}}">
        <view class="meta-num">{{recipe.ingredients.length}}</view>
        <view class="meta-label">种食材</view>
      </view>
    </view>

    <!-- 食材清单 -->
    <view class="section card">
      <view class="section-title">食材清单</view>
      <view class="ing-row" wx:for="{{recipe.ingredients}}" wx:key="index">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-qty">{{item.qty}}</text>
      </view>
      <view class="empty" wx:if="{{!recipe.ingredients.length}}">
        <view class="text">暂无食材信息</view>
      </view>
    </view>

    <!-- 做法步骤 -->
    <view class="section card">
      <view class="section-title">做法步骤</view>
      <view class="step-item" wx:for="{{recipe.directions}}" wx:key="index">
        <view class="step-no">{{index + 1}}</view>
        <view class="step-text">{{item.description}}</view>
      </view>
      <view class="empty" wx:if="{{!recipe.directions.length}}">
        <view class="text">暂无步骤信息</view>
      </view>
    </view>

    <view class="bottom">— 做法完毕，开动吧 —</view>
  </block>

</view>
